# Required for live searches; keep your own token in .env only.
APIFY_API_TOKEN=

# Optional local server and storage settings.
# PORT=4317
# DATA_DIR=./data

# Optional result cap per keyword and source. More items may cost more. Default: 10.
# MAX_ITEMS_PER_KEYWORD=10

# Optional Actor overrides. Use only Actors with the same input/output shape.
# APIFY_ACTOR_LINKEDIN=harvestapi/linkedin-post-search
# APIFY_ACTOR_X=xquik/x-tweet-scraper
# APIFY_ACTOR_WEB_SEARCH=apify/google-search-scraper
